          }
        },
        "required": [
          "dataset"
        ]
      },
      "then": {
        "properties": {
          "task": {
            "x-type": "string",
            "enum": [
              "forecasting"
            ],
            "default": "forecasting"
          }
        }
      }
    },
    {
      "if": {
