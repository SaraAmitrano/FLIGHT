                    "description": "Second moment parameter of the server optimizer"
                  },
                  "tau": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 1e-09,
                    "title": "Adaptivity degree",
                    "description": "Controls the algorithm's degree of adaptability"
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aggregation_model": {
            "properties": {
