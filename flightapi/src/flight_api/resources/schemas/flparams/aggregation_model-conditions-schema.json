        "properties": {
          "aggregation_model": {
            "properties": {
              "type": {
                "const": "FedProx"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "aggregation_model"
        ]
      },
      "then": {
        "properties": {
          "aggregation_model": {
            "properties": {
              "params": {
                "properties": {
                  "proximal_mu": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0.1,
                    "title": "Proximal term",
                    "description": "Proximal term parameter for FedProx aggregation"
                  }
                },
                "required": [
                  "proximal_mu"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
