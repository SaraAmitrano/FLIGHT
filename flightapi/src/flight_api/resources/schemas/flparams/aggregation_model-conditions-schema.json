                "properties": {
                  "func": {
                    "type": "string",
                    "default": "",
                    "title": "Custom aggregation function",
                    "description": "Base64-encoded custom aggregation function code",
                    "x-base64": true,
                    "x-textarea": true,
                    "x-max-length": 2000
                  }
                },
                "required": [
                  "func"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
