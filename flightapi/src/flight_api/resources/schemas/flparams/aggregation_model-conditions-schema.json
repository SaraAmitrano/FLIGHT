                "const": "FedAvgM"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "aggregation_model"
        ]
      },
      "then": {
        "properties": {
          "aggregation_model": {
            "properties": {
              "params": {
                "properties": {
                  "server_learning_rate": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 1.0,
                    "title": "Server learning rate",
                    "description": "Server-side learning rate of FedAvgM"
                  },
                  "server_momentum": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 1,
                    "default": 0.9,
                    "title": "Server momentum",
                    "description": "Server-side momentum of FedAvgM"
                  }
                },
                "required": [
                  "server_momentum"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aggregation_model": {
            "properties": {
              "type": {
                "const": "FedAdam"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "aggregation_model"
        ]
      },
      "then": {
        "properties": {
          "aggregation_model": {
            "properties": {
              "params": {
                "properties": {
                  "eta": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 0.1,
                    "title": "Server learning rate",
                    "description": "Server-side learning rate of FedAdam"
                  },
                  "beta_1": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 1,
                    "default": 0.9,
